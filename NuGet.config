<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins package restore to the public nuget.org feed only.

  `<clear />` is deliberate: it discards any machine- or user-level feeds so that a
  clone of this repository restores identically on a developer laptop and in CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
