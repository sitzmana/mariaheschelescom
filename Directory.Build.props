<Project>

  <!--
    Repository-wide MSBuild defaults.

    Every project in this repository inherits these settings, so individual .csproj
    files stay small and only describe what is genuinely project specific.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Code quality">
    <!--
      Unconditional, so a local build and a CI build agree. Making this CI-only seemed kinder
      but was worse: it let warnings through locally and turned every push into the first
      place anyone found out, which is the slowest possible feedback loop.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      NU1900 means NuGet could not reach the vulnerability database. That is infrastructure,
      not code: it fires on any network-restricted or offline machine and must never fail a
      build. It stays visible as a warning. Actual advisories are NU1901-NU1904 and are
      deliberately left as errors.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>

    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: members are documented where it adds value, not mechanically. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Repeatability">
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
