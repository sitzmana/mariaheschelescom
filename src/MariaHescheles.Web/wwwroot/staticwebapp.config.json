{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/css/*",
      "/js/*",
      "/data/*",
      "/media/*",
      "/models/*",
      "/fonts/*",
      "/*.{png,jpg,jpeg,webp,avif,svg,ico,glb,gltf,bin,hdr,woff2,json,txt,xml,webmanifest}"
    ]
  },

  "mimeTypes": {
    ".glb": "model/gltf-binary",
    ".gltf": "model/gltf+json",
    ".bin": "application/octet-stream",
    ".hdr": "image/vnd.radiance",
    ".webmanifest": "application/manifest+json",
    ".woff2": "font/woff2",
    ".wasm": "application/wasm",
    ".dat": "application/octet-stream"
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=(), interest-cohort=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://www.gstatic.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
  },

  "routes": [
    {
      "route": "/_framework/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/media/*",
      "headers": { "Cache-Control": "public, max-age=2592000" }
    },
    {
      "route": "/models/*",
      "headers": { "Cache-Control": "public, max-age=2592000" }
    },
    {
      "route": "/fonts/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/data/*",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    }
  ]
}
